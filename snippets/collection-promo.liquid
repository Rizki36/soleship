{% doc %}
  Renders the promo tile that sits inside the collection product grid as a
  list item spanning two columns.

  @param {block} block - The section's promo block

  @example
  {% render 'collection-promo', block: promo %}
{% enddoc %}

<li class="collection-promo" style="--promo-bg: {{ block.settings.background }};" {{ block.shopify_attributes }}>
  {%- if block.settings.image -%}
    {{
      block.settings.image
      | image_url: width: 1400
      | image_tag:
        loading: 'lazy',
        widths: '500, 700, 1000, 1400',
        sizes: '(min-width: 990px) 45vw, 100vw',
        class: 'collection-promo__image',
        alt: ''
    }}
  {%- endif -%}

  <div class="collection-promo__overlay">
    {%- if block.settings.eyebrow != blank -%}
      <p class="collection-promo__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if block.settings.title != blank -%}
      <h2 class="collection-promo__title heading-display">{{ block.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if block.settings.text != blank -%}
      <p class="collection-promo__text">{{ block.settings.text | escape }}</p>
    {%- endif -%}
    {%- if block.settings.button_label != blank -%}
      {% render 'button', label: block.settings.button_label, url: block.settings.button_link, style: 'hero' %}
    {%- endif -%}
  </div>
</li>

{% stylesheet %}
  .collection-promo {
    position: relative;
    display: flex;
    grid-column: span 2;
    min-height: 344px;
    overflow: hidden;
    border-radius: 16px;
    background: var(--promo-bg);
    color: #fff;
  }

  /* A single-column grid can't fit a two-column tile */
  [data-view='rows'] > .collection-promo {
    grid-column: 1 / -1;
  }

  .collection-promo__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-promo__overlay {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 14px;
    padding: 32px;
    background: linear-gradient(0deg, rgb(58 12 14 / 0.95) 0%, rgb(58 12 14 / 0) 75%);
  }

  .collection-promo__eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ff8a8f;
  }

  .collection-promo__title {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .collection-promo__text {
    max-width: 420px;
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: #f0d3d4;
  }

  .collection-promo .button {
    margin-top: 4px;
    font-size: 15px;
  }

  @media (max-width: 599px) {
    .collection-promo {
      min-height: 300px;
    }

    .collection-promo__overlay {
      padding: 24px;
    }
  }
{% endstylesheet %}
