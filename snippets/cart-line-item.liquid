{% doc %}
  Renders one cart line: thumbnail, tag pill, title, variant, price,
  save-for-later and remove actions, a quantity stepper and the line total.

  The stepper and actions carry `data-line` so the `cart-page` element can
  update the line through the Ajax Cart API. Remove is a plain link to
  `item.url_to_remove`, so it still works without JavaScript.

  @param {line_item} item - The cart line item
  @param {number} line - The 1-based position of the line in the cart
  @param {string} [hidden_tags] - Comma-separated product tags that never show as the tag pill

  @example
  {% render 'cart-line-item', item: item, line: forloop.index, hidden_tags: section.settings.hidden_tags %}
{% enddoc %}

{%- liquid
  assign hidden_tag_list = hidden_tags | downcase | replace: ', ', ',' | split: ','
  assign tag_label = ''
  for tag in item.product.tags
    assign tag_key = tag | downcase
    unless hidden_tag_list contains tag_key
      assign tag_label = tag | capitalize
      break
    endunless
  endfor

  assign compare_at = item.variant.compare_at_price | default: 0
  assign show_compare = false
  if compare_at > item.original_price
    assign show_compare = true
  endif

  assign at_max = false
  if item.variant.inventory_management == 'shopify'
    if item.variant.inventory_policy == 'deny'
      if item.quantity >= item.variant.inventory_quantity
        assign at_max = true
      endif
    endif
  endif

  assign decrease_quantity = item.quantity | minus: 1
  assign increase_quantity = item.quantity | plus: 1
  assign image_url = ''
  if item.image
    assign image_url = item.image | image_url: width: 300
  endif
-%}

<div class="cart-line" data-line-key="{{ item.key }}">
  <div class="cart-line__product">
    <a class="cart-line__thumb" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
      {%- if item.image -%}
        {{
          item.image
          | image_url: width: 300
          | image_tag: loading: 'lazy', widths: '150, 300', sizes: '148px', alt: item.image.alt
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </a>

    <div class="cart-line__info">
      {%- if tag_label != blank -%}
        <span class="cart-line__tag">{{ tag_label | escape }}</span>
      {%- endif -%}
      <h3 class="cart-line__title heading-display">
        <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
      </h3>
      {%- unless item.product.has_only_default_variant -%}
        <p class="cart-line__variant">{{ item.variant.title | replace: ' / ', ' · ' | escape }}</p>
      {%- endunless -%}
      {%- for property in item.properties -%}
        {%- assign property_first_char = property.first | slice: 0 -%}
        {%- if property.last != blank and property_first_char != '_' -%}
          <p class="cart-line__variant">{{ property.first | escape }}: {{ property.last | escape }}</p>
        {%- endif -%}
      {%- endfor -%}

      <p class="cart-line__price">
        <span class="cart-line__price-current">{{ item.original_price | money_without_trailing_zeros }}</span>
        {%- if show_compare -%}
          <s class="cart-line__price-compare">
            <span class="visually-hidden">{{ 'cart.regular_price' | t }}</span>
            {{- compare_at | money_without_trailing_zeros -}}
          </s>
        {%- endif -%}
      </p>

      {%- for allocation in item.line_level_discount_allocations -%}
        {%- assign allocation_amount = allocation.amount | money_without_trailing_zeros -%}
        <p class="cart-line__discount">
          {% render 'icon', name: 'ticket-percent' %}
          {{ allocation.discount_application.title | escape }} (−{{ allocation_amount }})
        </p>
      {%- endfor -%}

      <div class="cart-line__actions">
        <button
          type="button"
          class="cart-line__action"
          data-save-later
          data-line="{{ line }}"
          data-variant-id="{{ item.variant_id }}"
          data-title="{{ item.product.title | escape }}"
          data-variant="{% unless item.product.has_only_default_variant %}{{ item.variant.title | replace: ' / ', ' · ' | escape }}{% endunless %}"
          data-url="{{ item.url }}"
          data-image="{{ image_url }}"
          data-price="{{ item.original_price | money_without_trailing_zeros | escape }}"
        >
          {% render 'icon', name: 'heart' %}
          {{ 'cart.save_for_later' | t }}
        </button>
        <a class="cart-line__action" href="{{ item.url_to_remove }}" data-cart-remove data-line="{{ line }}">
          {% render 'icon', name: 'trash-2' %}
          {{ 'cart.remove' | t }}
        </a>
      </div>
    </div>
  </div>

  <div class="cart-line__quantity">
    <div class="cart-line__stepper">
      <button
        type="button"
        class="cart-line__step"
        data-line="{{ line }}"
        data-quantity="{{ decrease_quantity }}"
        aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}"
      >
        {% render 'icon', name: 'minus' %}
      </button>
      <span class="cart-line__qty" aria-label="{{ 'cart.quantity' | t }}">{{ item.quantity }}</span>
      <button
        type="button"
        class="cart-line__step"
        data-line="{{ line }}"
        data-quantity="{{ increase_quantity }}"
        aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}"
        {% if at_max %}
          disabled
        {% endif %}
      >
        {% render 'icon', name: 'plus' %}
      </button>
    </div>
  </div>

  <p class="cart-line__total">
    {%- if item.final_line_price < item.original_line_price -%}
      <s class="cart-line__total-original">{{ item.original_line_price | money_without_trailing_zeros }}</s>
    {%- endif -%}
    {{ item.final_line_price | money_without_trailing_zeros }}
  </p>
</div>

{% stylesheet %}
  .cart-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 148px 110px;
    align-items: center;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-line__product {
    display: flex;
    align-items: center;
    gap: 24px;
    min-width: 0;
  }

  .cart-line__thumb {
    flex-shrink: 0;
    width: 148px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 18px;
    background: var(--color-surface);
  }

  .cart-line__thumb img,
  .cart-line__thumb svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-line__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    min-width: 0;
  }

  .cart-line__tag {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-brand);
    font-size: 12px;
    font-weight: 600;
  }

  .cart-line__title {
    margin: 0;
    font-size: 30px;
    line-height: 32px;
  }

  .cart-line__title a {
    text-decoration: none;
  }

  .cart-line__variant,
  .cart-line__discount {
    margin: 0;
    font-size: 14px;
    color: var(--color-muted);
  }

  .cart-line__discount {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent);
    font-weight: 600;
  }

  .cart-line__discount .icon {
    width: 14px;
    height: 14px;
  }

  .cart-line__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
  }

  .cart-line__price-current {
    font-size: 16px;
    font-weight: 700;
  }

  .cart-line__price-compare {
    font-size: 14px;
    color: var(--color-muted);
  }

  .cart-line__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    padding-top: 6px;
  }

  .cart-line__action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    font-size: 13px;
    text-decoration: none;
  }

  .cart-line__action:hover {
    color: var(--color-foreground);
  }

  .cart-line__action .icon {
    width: 14px;
    height: 14px;
  }

  .cart-line__stepper {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 46px;
    padding: 0 6px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .cart-line__step {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
  }

  .cart-line__step:hover:not([disabled]) {
    background: var(--color-surface);
  }

  .cart-line__step[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .cart-line__step .icon {
    width: 16px;
    height: 16px;
  }

  .cart-line__qty {
    min-width: 16px;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
  }

  .cart-line__total {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }

  .cart-line__total-original {
    font-size: 13px;
    font-weight: 400;
    color: var(--color-muted);
  }

  @media (max-width: 599px) {
    .cart-line {
      grid-template-columns: 96px minmax(0, 1fr) auto;
      gap: 16px;
      padding: 22px 0;
    }

    .cart-line__product {
      display: contents;
    }

    .cart-line__thumb {
      width: 96px;
      align-self: start;
      border-radius: 14px;
    }

    .cart-line__title {
      font-size: 22px;
      line-height: 24px;
    }

    .cart-line__thumb {
      grid-row: 1;
    }

    .cart-line__info {
      grid-column: 2 / -1;
    }

    .cart-line__quantity {
      grid-column: 2;
    }

    .cart-line__stepper {
      height: 40px;
      gap: 0;
      padding: 0 2px;
    }

    .cart-line__step {
      width: 30px;
      height: 30px;
    }

    .cart-line__total {
      align-items: flex-end;
      text-align: right;
    }
  }
{% endstylesheet %}
