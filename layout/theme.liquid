<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% # Brand fonts: Anton (display) and Familjen Grotesk (body) %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Familjen+Grotesk:wght@400..700&display=swap"
      rel="stylesheet"
    >

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>

    <div class="header-wrapper">
      {% sections 'header-group' %}
    </div>

    <main id="main-content">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
