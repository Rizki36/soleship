<div class="product-specs full-width" style="--section-bg: {{ section.settings.background }};">
  <div class="product-specs__inner page-width">
    <div class="product-specs__intro">
      {%- if section.settings.show_eyebrow and product -%}
        <p class="product-specs__eyebrow">{{ 'products.inside_product' | t: title: product.title }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="product-specs__title heading-display">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="product-specs__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="product-specs__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="product-specs__item" {{ block.shopify_attributes }}>
            {%- render 'icon', name: block.settings.icon, class: 'product-specs__icon' -%}
            <h3 class="product-specs__item-title heading-display">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="product-specs__item-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-specs {
    background: var(--section-bg);
    color: #fff;
  }

  .product-specs__inner {
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
    align-items: center;
    gap: 72px;
    padding: 96px 0;
  }

  .product-specs__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .product-specs__eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #ff8a8f;
  }

  .product-specs__title {
    margin: 0;
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
  }

  .product-specs__text {
    margin: 0;
    font-size: 17px;
    line-height: 26px;
    color: #e3c4c5;
  }

  .product-specs__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-specs__item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 36px;
  }

  .product-specs__item:nth-child(odd) {
    padding-left: 0;
    border-right: 1px solid rgb(255 255 255 / 0.14);
  }

  .product-specs__item:nth-child(n + 3) {
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .product-specs__icon {
    width: 28px;
    height: 28px;
    color: #ff8a8f;
  }

  .product-specs__item-title {
    margin: 0;
    font-size: 28px;
  }

  .product-specs__item-text {
    margin: 0;
    font-size: 16px;
    line-height: 24px;
    color: #d9b8b9;
  }

  @media (max-width: 989px) {
    .product-specs__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding: 72px 0;
    }
  }

  @media (max-width: 599px) {
    .product-specs__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-specs__item,
    .product-specs__item:nth-child(odd) {
      padding: 28px 0;
      border-right: 0;
    }

    .product-specs__item:nth-child(n + 2) {
      border-top: 1px solid rgb(255 255 255 / 0.14);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_specs.name",
  "class": "section-product-specs",
  "enabled_on": {
    "templates": ["product"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "t:labels.show_product_eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Engineered layer by layer"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "Every component is chosen to survive concrete, gravel and rain — without the weight of a traditional boot."
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:labels.background",
      "default": "#5A1F22"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "t:blocks.spec",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "default": "droplets",
          "options": [
            { "value": "droplets", "label": "t:options.icon.droplets" },
            { "value": "activity", "label": "t:options.icon.activity" },
            { "value": "footprints", "label": "t:options.icon.footprints" },
            { "value": "feather", "label": "t:options.icon.feather" },
            { "value": "wind", "label": "t:options.icon.wind" },
            { "value": "shield", "label": "t:options.icon.shield" },
            { "value": "shield-check", "label": "t:options.icon.shield_check" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Waterproof"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Seam-sealed membrane rated to 10,000mm."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_specs.name",
      "blocks": [
        { "type": "spec", "settings": { "icon": "droplets", "title": "Waterproof", "text": "Seam-sealed membrane rated to 10,000mm." } },
        { "type": "spec", "settings": { "icon": "activity", "title": "Shock-absorb", "text": "Dual-density EVA midsole, 8mm drop." } },
        { "type": "spec", "settings": { "icon": "footprints", "title": "Grip", "text": "5mm multi-directional lugs for wet & dry." } },
        { "type": "spec", "settings": { "icon": "feather", "title": "Lightweight", "text": "Just 410g per shoe in a US 9." } }
      ]
    }
  ]
}
{% endschema %}
