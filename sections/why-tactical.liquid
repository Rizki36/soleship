<div class="why-tactical">
  <div class="why-tactical__content">
    <div class="why-tactical__heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="why-tactical__title heading-display heading-xl">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="why-tactical__features" role="list">
        {%- for block in section.blocks -%}
          <li class="why-tactical__feature" {{ block.shopify_attributes }}>
            <span class="why-tactical__index">
              {%- if forloop.index < 10 %}0{% endif %}{{ forloop.index -}}
            </span>
            <div class="why-tactical__copy">
              <h3 class="why-tactical__feature-title">{{ block.settings.title | escape }}</h3>
              <p class="why-tactical__feature-text">{{ block.settings.text | escape }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      {% render 'button',
        label: section.settings.button_label,
        url: section.settings.button_link,
        style: 'arrow'
      %}
    {%- endif -%}
  </div>

  <div class="why-tactical__media">
    {%- if section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: 1300
        | image_tag:
          widths: '500, 800, 1000, 1300',
          sizes: '(min-width: 990px) 45vw, 100vw',
          class: 'why-tactical__image'
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'why-tactical__image why-tactical__image--placeholder' }}
    {%- endif -%}

    {%- if section.settings.badge != blank -%}
      <p class="why-tactical__badge">
        {% render 'icon', name: 'shield-check' %}
        {{ section.settings.badge | escape }}
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .why-tactical {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 620px);
    align-items: center;
    gap: 80px;
    padding: 112px 0;
  }

  .why-tactical__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
  }

  .why-tactical__heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .why-tactical__title {
    margin: 0;
  }

  .why-tactical__features {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .why-tactical__feature {
    display: flex;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .why-tactical__feature:first-child {
    border-top: 1px solid var(--color-border);
  }

  .why-tactical__index {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-accent);
  }

  .why-tactical__copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .why-tactical__feature-title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
  }

  .why-tactical__feature-text {
    margin: 0;
    font-size: 16px;
    color: var(--color-muted);
  }

  .why-tactical__media {
    position: relative;
    aspect-ratio: 620 / 640;
    overflow: hidden;
    border-radius: 24px;
    background: var(--color-surface);
  }

  .why-tactical__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .why-tactical__badge {
    position: absolute;
    left: 28px;
    bottom: 28px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 12px 18px;
    border-radius: 999px;
    background: #fff;
    font-size: 14px;
    font-weight: 600;
  }

  .why-tactical__badge .icon {
    width: 18px;
    height: 18px;
    color: var(--color-accent);
  }

  @media (max-width: 989px) {
    .why-tactical {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 72px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.why_tactical.name",
  "class": "section-why-tactical",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Built different"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Why tactical sneakers?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "See more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:labels.badge",
      "default": "Tested on 40+ terrains"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:blocks.feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Built for impact"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Reinforced structure for rough terrain and daily wear."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.why_tactical.name",
      "blocks": [
        { "type": "feature", "settings": { "title": "Built for impact", "text": "Reinforced structure for rough terrain and daily wear." } },
        { "type": "feature", "settings": { "title": "All-day comfort", "text": "Cushioned midsoles designed for long hours on your feet." } },
        { "type": "feature", "settings": { "title": "Superior grip", "text": "Slip-resistant outsole for maximum traction on any surface." } },
        { "type": "feature", "settings": { "title": "Weather ready", "text": "Breathable yet water-resistant materials that dry fast." } }
      ]
    }
  ]
}
{% endschema %}
