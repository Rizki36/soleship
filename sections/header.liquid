{%- liquid
  assign transparent = false
  if section.settings.transparent_on_home and template.name == 'index'
    assign transparent = true
  endif
-%}

{%- if transparent -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      position: absolute;
      left: 0;
      right: 0;
    }
  {% endstyle %}
{%- endif -%}

<header
  class="site-header full-width{% if transparent %} site-header--transparent{% endif %}"
  style="--header-bg: {{ section.settings.background }};"
>
  <div class="site-header__inner">
    <div class="site-header__start">
      <details class="site-header__drawer">
        <summary class="site-header__drawer-toggle" aria-label="{{ 'header.menu' | t }}">
          {% render 'icon', name: 'menu', class: 'site-header__icon-open' %}
          {% render 'icon', name: 'close', class: 'site-header__icon-close' %}
        </summary>
        <nav class="site-header__drawer-nav" aria-label="{{ 'header.menu' | t }}">
          {%- for link in section.settings.menu.links -%}
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- endfor -%}
        </nav>
      </details>

      <nav class="site-header__nav" aria-label="{{ 'header.menu' | t }}">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      </nav>
    </div>

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag: alt: shop.name, class: 'site-header__logo-image', loading: 'eager'
        }}
      {%- else -%}
        {{ shop.name | upcase | escape }}
      {%- endif -%}
    </a>

    <div class="site-header__actions">
      <a
        class="site-header__pill site-header__search"
        href="{{ routes.search_url }}"
        aria-haspopup="dialog"
        data-search-open
      >
        {% render 'icon', name: 'search' %}
        <span>{{ 'header.search' | t }}</span>
      </a>

      <div class="site-header__pill site-header__icons">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
            {% render 'icon', name: 'user' %}
          </a>
        {%- endif -%}
        <a class="site-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t }}">
          {% render 'icon', name: 'bag' %}
          <span class="site-header__cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>
            {{- cart.item_count -}}
          </span>
        </a>
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    background: var(--header-bg);
    color: #fff;
  }

  .site-header--transparent {
    background: transparent;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 28px var(--page-margin);
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .site-header a {
    color: inherit;
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 32px;
    font-size: 15px;
    color: #f4e3e3;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current] {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .site-header__logo {
    justify-self: center;
    font-family: var(--font-heading--family);
    font-size: 30px;
    letter-spacing: 1.5px;
    line-height: 1;
  }

  .site-header__logo-image {
    max-height: 40px;
    width: auto;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
  }

  .site-header__pill {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    font-size: 15px;
  }

  .site-header__search {
    gap: 8px;
  }

  .site-header__pill .icon {
    width: 16px;
    height: 16px;
  }

  .site-header__icons a {
    display: inline-flex;
  }

  .site-header__cart {
    position: relative;
  }

  .site-header__cart-count {
    position: absolute;
    top: -8px;
    right: -10px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--color-accent);
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
  }

  .site-header__cart-count[hidden] {
    display: none;
  }

  .site-header__drawer {
    display: none;
  }

  .site-header__drawer-toggle {
    display: inline-flex;
    list-style: none;
    cursor: pointer;
  }

  .site-header__drawer-toggle::-webkit-details-marker {
    display: none;
  }

  .site-header__drawer-toggle .icon {
    width: 24px;
    height: 24px;
  }

  .site-header__icon-close,
  .site-header__drawer[open] .site-header__icon-open {
    display: none;
  }

  .site-header__drawer[open] .site-header__icon-close {
    display: block;
  }

  .site-header__drawer-nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    padding: 8px var(--page-margin) 24px;
    background: var(--color-brand-dark);
  }

  .site-header__drawer-nav a {
    padding: 12px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    font-size: 18px;
  }

  @media (max-width: 989px) {
    .site-header__inner {
      position: relative;
      padding-block: 18px;
    }

    .site-header__nav {
      display: none;
    }

    .site-header__drawer {
      display: block;
    }

    .site-header__logo {
      font-size: 26px;
    }

    .site-header__search span {
      display: none;
    }

    .site-header__pill {
      padding: 10px 14px;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Progressive enhancement for any form marked with `data-ajax-cart`:
   * adds the item through the Ajax Cart API and updates every
   * `[data-cart-count]` badge instead of redirecting to the cart page.
   */
  (function () {
    if (window.soleshipAjaxCart) return;
    window.soleshipAjaxCart = true;

    const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

    function updateCount(count) {
      document.querySelectorAll('[data-cart-count]').forEach((badge) => {
        badge.textContent = count;
        badge.hidden = count === 0;
      });
    }

    document.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-ajax-cart')) return;

      event.preventDefault();
      const button = form.querySelector('[type="submit"]');
      const label = form.querySelector('[data-add-label]');
      button?.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch(`${root}cart/add.js`, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!response.ok) throw new Error('Add to cart failed');

        const cart = await fetch(`${root}cart.js`).then((res) => res.json());
        updateCount(cart.item_count);

        if (label && label.dataset.addedText) {
          const original = label.textContent;
          label.textContent = label.dataset.addedText;
          setTimeout(() => (label.textContent = original), 2000);
        }
      } catch (error) {
        form.removeAttribute('data-ajax-cart');
        form.submit();
      } finally {
        button?.removeAttribute('aria-busy');
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_home",
      "label": "t:labels.transparent_on_home",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:labels.background",
      "default": "#7E1B1F"
    }
  ]
}
{% endschema %}
