{%- if section.settings.text != blank -%}
  <div
    class="announcement-bar full-width"
    style="--announcement-bg: {{ section.settings.background }}; --announcement-fg: {{ section.settings.text_color }};"
  >
    {%- if section.settings.link != blank -%}
      <a class="announcement-bar__content" href="{{ section.settings.link }}">
    {%- else -%}
      <p class="announcement-bar__content">
    {%- endif -%}
    {%- if section.settings.show_icon -%}
      {% render 'icon', name: 'truck' %}
    {%- endif -%}
    <span>{{ section.settings.text | escape }}</span>
    {%- if section.settings.link != blank -%}
      </a>
    {%- else -%}
      </p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    background: var(--announcement-bg);
    color: var(--announcement-fg);
  }

  .announcement-bar__content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0;
    padding: 10px var(--page-margin);
    font-size: 13px;
    text-align: center;
    text-decoration: none;
  }

  .announcement-bar__content .icon {
    width: 14px;
    height: 14px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "section-announcement-bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "Free shipping on orders over Rp 2.000.000 · 30-day trail-tested returns"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "t:labels.show_icon",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:labels.background",
      "default": "#5A1F22"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#F3D9DA"
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name"
    }
  ]
}
{% endschema %}
