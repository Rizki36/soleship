{%- liquid
  assign featured = section.settings.product
  assign carousel_collection = section.settings.collection
  assign color_option = null
  if featured
    for option in featured.options_with_values
      assign option_name = option.name | downcase
      if option_name == 'color' or option_name == 'colour'
        assign color_option = option
      endif
    endfor
  endif
-%}

<div class="best-sellers full-width" style="--section-bg: {{ section.settings.background }};">
  <div class="best-sellers__inner page-width">
    {%- if featured -%}
      <featured-product
        class="best-sellers__featured"
        data-add-text="{{ 'products.add_to_cart' | t }}"
        data-sold-out-text="{{ 'products.sold_out' | t }}"
      >
        {%- form 'product', featured, class: 'best-sellers__form', data-ajax-cart: '' -%}
          <input type="hidden" name="id" value="{{ featured.selected_or_first_available_variant.id }}" data-variant-id>

          <div class="best-sellers__stage">
            {%- if section.settings.watermark != blank -%}
              <p class="best-sellers__watermark heading-display" aria-hidden="true">
                <span>{{ section.settings.watermark | escape }}</span>
                <span>{{ section.settings.watermark | escape }}</span>
              </p>
            {%- endif -%}

            {%- assign featured_image = section.settings.featured_image | default: featured.featured_image -%}
            {%- if featured_image -%}
              {{
                featured_image
                | image_url: width: 1800
                | image_tag:
                  widths: '600, 900, 1200, 1800',
                  sizes: '(min-width: 990px) 60vw, 100vw',
                  class: 'best-sellers__shoe',
                  alt: featured.title
              }}
            {%- endif -%}

            <button type="submit" class="best-sellers__add"{% unless featured.available %} disabled{% endunless %}>
              <span class="button__circle">{% render 'icon', name: 'arrow-up-right' %}</span>
              <span data-add-label data-added-text="{{ 'products.added_to_cart' | t }}">
                {%- if featured.available -%}
                  {{- 'products.add_to_cart' | t -}}
                {%- else -%}
                  {{- 'products.sold_out' | t -}}
                {%- endif -%}
              </span>
            </button>
          </div>

          <div class="best-sellers__meta">
            <div class="best-sellers__options">
              {%- for option in featured.options_with_values -%}
                {%- if option == color_option -%}
                  <fieldset class="best-sellers__swatches">
                    <legend class="visually-hidden">{{ option.name | escape }}</legend>
                    {%- for value in option.values -%}
                      {%- capture swatch_color -%}{% render 'swatch-color', value: value %}{%- endcapture -%}
                      <label class="best-sellers__swatch" style="--swatch: {{ swatch_color }};">
                        <input
                          type="radio"
                          name="option-{{ option.position }}"
                          value="{{ value | escape }}"
                          data-option-position="{{ option.position }}"
                          {% if value.selected %}checked{% endif %}
                        >
                        <span class="visually-hidden">{{ value | escape }}</span>
                      </label>
                    {%- endfor -%}
                  </fieldset>
                {%- elsif option.values.size > 1 -%}
                  <label class="best-sellers__select">
                    <span class="visually-hidden">{{ option.name | escape }}</span>
                    <select name="option-{{ option.position }}" data-option-position="{{ option.position }}">
                      {%- for value in option.values -%}
                        <option value="{{ value | escape }}"{% if value.selected %} selected{% endif %}>
                          {{- option.name | escape }}: {{ value | escape -}}
                        </option>
                      {%- endfor -%}
                    </select>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="best-sellers__summary">
              <div class="best-sellers__name">
                <h2 class="best-sellers__title">
                  <a href="{{ featured.url }}">{{ featured.title | escape }}</a>
                </h2>
                {%- assign tagline = section.settings.tagline | default: featured.type -%}
                {%- if tagline != blank -%}
                  <p class="best-sellers__tagline">{{ tagline | escape }}</p>
                {%- endif -%}
              </div>
              <div class="best-sellers__price">
                <span class="best-sellers__price-label">{{ 'products.price' | t }}</span>
                <span class="best-sellers__price-value" data-price>
                  {{- featured.selected_or_first_available_variant.price | money_without_trailing_zeros -}}
                </span>
              </div>
            </div>
          </div>
        {%- endform -%}

        <script type="application/json" data-variants>
          {{ featured.variants | json }}
        </script>
        <script type="application/json" data-prices>
          {
            {%- for variant in featured.variants -%}
              "{{ variant.id }}": {{ variant.price | money_without_trailing_zeros | json }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          }
        </script>
      </featured-product>
    {%- endif -%}

    {%- if carousel_collection != blank -%}
      {% render 'product-carousel',
        products: carousel_collection.products,
        heading: section.settings.row_heading,
        limit: section.settings.products_to_show,
        class: 'best-sellers__row'
      %}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .best-sellers {
    overflow-x: clip;
    background: var(--section-bg);
    padding: 96px 0 104px;
  }

  .best-sellers__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .best-sellers__featured {
    display: block;
  }

  .best-sellers__form {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .best-sellers__stage {
    position: relative;
    aspect-ratio: 1296 / 520;
    min-height: 260px;
  }

  .best-sellers__watermark {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    font-size: min(18.2vw, 236px);
    line-height: 0.805;
    letter-spacing: 4px;
    color: #ece1e0;
    white-space: nowrap;
    user-select: none;
  }

  .best-sellers__shoe {
    position: absolute;
    left: 50%;
    top: -4%;
    width: 66%;
    height: 111%;
    object-fit: contain;
    transform: translateX(-50%);
    filter: drop-shadow(0 30px 30px rgb(21 19 19 / 0.12));
  }

  /* The add to cart pill floats over the middle of the shoe stage */
  .best-sellers__add {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 22px 6px 6px;
    border: 0;
    border-radius: 999px;
    outline: 1px solid rgb(255 255 255 / 0.25);
    outline-offset: -1px;
    background: rgb(21 19 19 / 0.6);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    transform: translateX(-50%);
  }

  .best-sellers__add .button__circle {
    --circle-size: 34px;
    --circle-bg: #fff;
    --circle-fg: var(--color-foreground);
  }

  .best-sellers__add[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .best-sellers__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  .best-sellers__options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .best-sellers__swatches {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .best-sellers__swatch {
    position: relative;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px rgb(21 19 19 / 0.1);
    cursor: pointer;
  }

  .best-sellers__swatch input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .best-sellers__swatch:has(input:checked) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .best-sellers__swatch:has(input:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .best-sellers__select select {
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: #fff;
    font-size: 14px;
  }

  .best-sellers__summary {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
  }

  .best-sellers__name {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .best-sellers__title {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
  }

  .best-sellers__title a {
    text-decoration: none;
  }

  .best-sellers__tagline {
    margin: 0;
    font-size: 15px;
    color: var(--color-muted);
  }

  .best-sellers__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .best-sellers__price-label {
    font-size: 14px;
    color: var(--color-muted);
  }

  .best-sellers__price-value {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-accent);
  }

  .best-sellers__row {
    --carousel-header-offset: 24px;
  }

  .best-sellers__row .product-carousel__title {
    letter-spacing: 0.5px;
  }

  @media (max-width: 989px) {
    .best-sellers {
      padding: 64px 0 72px;
    }

    .best-sellers__form {
      gap: 32px;
    }
  }

  @media (max-width: 599px) {
    .best-sellers__shoe {
      top: 0;
      width: 100%;
      height: 82%;
    }

    .best-sellers__add {
      top: auto;
      bottom: 0;
    }

    .best-sellers__summary {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .best-sellers__name,
    .best-sellers__price {
      align-items: center;
    }

    .best-sellers__price-value {
      font-size: 26px;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('featured-product')) {
    customElements.define(
      'featured-product',
      class FeaturedProduct extends HTMLElement {
        connectedCallback() {
          this.variants = JSON.parse(this.querySelector('[data-variants]')?.textContent || '[]');
          this.prices = JSON.parse(this.querySelector('[data-prices]')?.textContent || '{}');
          this.form = this.querySelector('form');
          this.form?.addEventListener('change', () => this.updateVariant());
        }

        updateVariant() {
          const selected = [];
          this.form.querySelectorAll('[data-option-position]').forEach((input) => {
            if (input.type === 'radio' && !input.checked) return;
            selected[Number(input.dataset.optionPosition) - 1] = input.value;
          });

          const variant = this.variants.find((candidate) =>
            candidate.options.every((value, index) => selected[index] === undefined || selected[index] === value)
          );
          if (!variant) return;

          this.form.querySelector('[data-variant-id]').value = variant.id;

          const button = this.form.querySelector('[type="submit"]');
          const label = this.form.querySelector('[data-add-label]');
          button.disabled = !variant.available;
          label.textContent = variant.available ? this.dataset.addText || label.textContent : this.dataset.soldOutText || label.textContent;

          const price = this.form.querySelector('[data-price]');
          if (price && this.prices[variant.id]) price.textContent = this.prices[variant.id];
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.best_sellers.name",
  "class": "section-best-sellers",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:headers.featured_product"
    },
    {
      "type": "text",
      "id": "watermark",
      "label": "t:labels.watermark",
      "default": "Best sellers"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "t:labels.featured_image",
      "info": "t:info.transparent_image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "t:labels.tagline",
      "default": "Daily wear · Anti-slip · Waterproof"
    },
    {
      "type": "header",
      "content": "t:headers.carousel"
    },
    {
      "type": "text",
      "id": "row_heading",
      "label": "t:labels.heading",
      "default": "More best sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:labels.background",
      "default": "#F8F2F1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.best_sellers.name"
    }
  ]
}
{% endschema %}
