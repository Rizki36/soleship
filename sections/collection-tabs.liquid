{%- liquid
  assign all_collection = section.settings.collection | default: collections.all
  assign limit = section.settings.products_to_show
-%}

<collection-tabs class="collection-tabs">
  <div class="collection-tabs__heading">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-tabs__title heading-display heading-xl">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="collection-tabs__subtitle">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="collection-tabs__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      <button
        type="button"
        class="collection-tabs__tab"
        role="tab"
        id="{{ section.id }}-tab-all"
        aria-controls="{{ section.id }}-panel-all"
        aria-selected="true"
      >
        {{- section.settings.all_label | escape -}}
      </button>
      {%- for block in section.blocks -%}
        {%- assign tab_label = block.settings.label | default: block.settings.collection.title -%}
        <button
          type="button"
          class="collection-tabs__tab"
          role="tab"
          id="{{ section.id }}-tab-{{ block.id }}"
          aria-controls="{{ section.id }}-panel-{{ block.id }}"
          aria-selected="false"
          tabindex="-1"
          {{ block.shopify_attributes }}
        >
          {{- tab_label | escape -}}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div
    class="collection-tabs__panel"
    role="tabpanel"
    id="{{ section.id }}-panel-all"
    aria-labelledby="{{ section.id }}-tab-all"
  >
    <ul class="collection-tabs__grid" role="list">
      {%- for product in all_collection.products limit: limit -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- else -%}
        <li class="collection-tabs__empty">{{ 'collections.empty' | t }}</li>
      {%- endfor -%}
    </ul>
  </div>

  {%- for block in section.blocks -%}
    <div
      class="collection-tabs__panel"
      role="tabpanel"
      id="{{ section.id }}-panel-{{ block.id }}"
      aria-labelledby="{{ section.id }}-tab-{{ block.id }}"
      hidden
    >
      <ul class="collection-tabs__grid" role="list">
        {%- for product in block.settings.collection.products limit: limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- else -%}
          <li class="collection-tabs__empty">{{ 'collections.empty' | t }}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endfor -%}

  {%- if section.settings.button_label != blank -%}
    {% render 'button', label: section.settings.button_label, url: all_collection.url, style: 'solid' %}
  {%- endif -%}
</collection-tabs>

{% stylesheet %}
  .collection-tabs {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    padding: 112px 0;
  }

  .collection-tabs__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .collection-tabs__title {
    margin: 0;
  }

  .collection-tabs__subtitle {
    margin: 0;
    font-size: 18px;
    color: var(--color-muted);
  }

  .collection-tabs__tabs {
    display: flex;
    gap: 8px;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .collection-tabs__tab {
    flex-shrink: 0;
    padding: 10px 20px;
    border: 0;
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 15px;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .collection-tabs__tab[aria-selected='true'] {
    background: var(--color-accent);
    color: #fff;
  }

  .collection-tabs__panel {
    width: 100%;
  }

  .collection-tabs__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-tabs__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .collection-tabs {
      gap: 36px;
      padding: 72px 0;
    }

    .collection-tabs__tabs {
      justify-content: flex-start;
      width: 100%;
    }

    .collection-tabs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 16px;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('collection-tabs')) {
    customElements.define(
      'collection-tabs',
      class CollectionTabs extends HTMLElement {
        connectedCallback() {
          this.tabs = [...this.querySelectorAll('[role="tab"]')];
          this.tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => this.select(tab));
            tab.addEventListener('keydown', (event) => {
              const offset = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
              if (!offset) return;
              const next = this.tabs[(index + offset + this.tabs.length) % this.tabs.length];
              next.focus();
              this.select(next);
            });
          });
        }

        select(activeTab) {
          this.tabs.forEach((tab) => {
            const active = tab === activeTab;
            tab.setAttribute('aria-selected', String(active));
            tab.tabIndex = active ? 0 : -1;
            document.getElementById(tab.getAttribute('aria-controls')).hidden = !active;
          });
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.collection_tabs.name",
  "class": "section-collection-tabs",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Our collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Find the right tactical sneaker for your mission, environment, and lifestyle."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "t:labels.all_label",
      "default": "All"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.all_collection",
      "info": "t:info.all_collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "View all products"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:blocks.tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label",
          "info": "t:info.tab_label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_tabs.name"
    }
  ]
}
{% endschema %}
