<div class="newsletter" style="--padding-top: {{ section.settings.padding_top }}px;">
  <div class="newsletter__card" style="--card-bg: {{ section.settings.background }};">
    <div class="newsletter__copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter__title heading-display">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="newsletter__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign form_id = 'newsletter-form-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'newsletter__form-wrapper' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- if form.posted_successfully? -%}
        <p class="newsletter__message" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__form">
          <label class="visually-hidden" for="newsletter-email-{{ section.id }}">{{ 'newsletter.email_label' | t }}</label>
          <input
            id="newsletter-email-{{ section.id }}"
            class="newsletter__input"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="{{ 'newsletter.email_placeholder' | t }}"
            required
            {% if form.errors %}
              aria-invalid="true" aria-describedby="newsletter-error-{{ section.id }}"
            {% endif %}
          >
          <button type="submit" class="newsletter__button">{{ 'newsletter.subscribe' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="newsletter__message" id="newsletter-error-{{ section.id }}" role="alert">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .newsletter {
    padding-top: var(--padding-top);
    padding-bottom: 112px;
  }

  .newsletter__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    padding: 64px;
    border-radius: 28px;
    background: var(--card-bg);
    color: #fff;
  }

  .newsletter__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1 1 0;
  }

  .newsletter__title {
    margin: 0;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
  }

  .newsletter__text {
    margin: 0;
    font-size: 18px;
    color: #f0d3d4;
  }

  .newsletter__form-wrapper {
    width: min(100%, 520px);
  }

  .newsletter__form {
    display: flex;
    align-items: center;
    padding: 6px 6px 6px 24px;
    border-radius: 999px;
    background: #fff;
  }

  .newsletter__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-foreground);
    font-size: 16px;
    outline: none;
  }

  .newsletter__input::placeholder {
    color: #9a9090;
  }

  .newsletter__form:focus-within {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .newsletter__button {
    flex-shrink: 0;
    padding: 16px 26px;
    border: 0;
    border-radius: 999px;
    background: var(--color-foreground);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
  }

  .newsletter__message {
    margin: 12px 0 0;
    font-size: 15px;
    color: #f0d3d4;
  }

  @media (max-width: 989px) {
    .newsletter {
      padding-top: min(var(--padding-top), 64px);
      padding-bottom: 72px;
    }

    .newsletter__card {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
      padding: 40px 24px;
    }

    .newsletter__form-wrapper {
      width: 100%;
    }

    .newsletter__button {
      padding: 14px 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Join the Soleship crew"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "Get 10% off your first pair, early drops, and field-tested gear guides."
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:labels.background",
      "default": "#7E1B1F"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name"
    }
  ]
}
{% endschema %}
